{
  "name": "harborage",
  "version": "0.2.0",
  "description": "A shared, on-demand pool of isolated headless browser sessions for Claude Code subagents.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "harborage": "dist/client/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/client/cli.js",
    "prepare": "npm run build",
    "daemon": "npm run build && node dist/daemon/index.js",
    "test": "npm run build && tsx --test --test-force-exit --test-timeout=180000 test/*.test.ts",
    "test:watch": "tsx --test --watch --test-force-exit --test-timeout=180000 test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "playwright": "^1.62.1",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
