# Both spellings, because a worktree gets its dependencies as a SYMLINK named
# node_modules rather than a directory, and a trailing-slash pattern does not
# match a symlink. Two agents committed one today without noticing.
node_modules
node_modules/
dist/
*.log
.DS_Store

# Claude Code worktrees, and one-off scratch probes kept out of the tree.
.claude/worktrees/
.probe-*.mjs
.probe-*.mts
/zz-*
